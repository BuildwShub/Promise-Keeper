# Copy to web/.env.local and fill in. Never commit .env.local. On Vercel, add the same names under Project Settings > Environment Variables.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Optional: Publishable key (safe to expose). Used as the apikey for user-scoped queries.
SUPABASE_PUBLISHABLE_KEY=

# Google OAuth web client (Google Cloud > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Auth.js session secret: run `npx auth secret` or any 32+ char random string
AUTH_SECRET=

# 32 random bytes, base64. Encrypts Google refresh tokens (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Gemini (paid tier key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Protects /api/cron/* and the Pub/Sub push endpoint
CRON_SECRET=

# Gmail push: full Pub/Sub topic name, e.g. projects/<gcp-project-id>/topics/gmail-push. Leave empty until the topic exists.
PUBSUB_TOPIC=

# Public site info used on the privacy and data-deletion pages
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
