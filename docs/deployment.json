{
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.metadata",
    "https://www.googleapis.com/auth/userinfo.email"
  ],
  "addOns": {
    "common": {
      "name": "Promise Keeper",
      "logoUrl": "https://www.gstatic.com/images/icons/material/system/2x/check_circle_black_24dp.png",
      "homepageTrigger": {
        "runFunction": "https://promise-keeper-omega.vercel.app/api/addon/homepage"
      }
    },
    "gmail": {
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "https://promise-keeper-omega.vercel.app/api/addon/message"
        }
      ]
    },
    "httpOptions": {
      "authorizationHeader": "SYSTEM_ID_TOKEN"
    }
  }
}
